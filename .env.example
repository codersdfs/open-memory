# Open Memory — env example

# DB
# MEMORY_DB_PATH=memory.db
# PORT=7331

# Embeddings — choose one
# EMBEDDING_PROVIDER=hash          # default 384d, offline, zero cost
# EMBEDDING_PROVIDER=openai
# EMBEDDING_PROVIDER=nim           # alias: nvidia, nvidia-nim
# EMBEDDING_DIM=                   # override for a model not listed below
#
# The dimension is load-bearing: the vector column holds raw JSON, so switching
# provider without clearing the store makes every search return noise rather than
# an error. Startup refuses on a mismatch and names both dims — move the file
# aside (mv memory.db memory.db.bak) to start fresh on the new provider.

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_EMBED_MODEL=text-embedding-3-small

# How far the best vector hit must lead its partition's median cosine before a memory
# with no shared words is admitted on vector evidence alone. Only fires with a real
# provider (the hash cosine is ~0.9 to everything and can lead nothing). 0.2 is the
# measured midpoint: unrelated queries never led by more than 0.176, four of six
# paraphrases led by 0.231-0.345. Raise for precision, lower for recall.
# MEMORY_SEMANTIC_MARGIN=0.2
# OPENAI_BASE_URL=https://api.openai.com/v1

# NVIDIA NIM — hosted integrate.api.nvidia.com or self-hosted (default: nemotron-3-embed-1b 2048d)
# NIM_API_KEY=nvapi-...
# NVIDIA_API_KEY=nvapi-...         # alias for NIM_API_KEY
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM_EMBED_MODEL=nvidia/nemotron-3-embed-1b  # 2048d, 32k ctx, SOTA (default)
# # NIM_EMBED_MODEL=nvidia/nv-embedqa-e5-v5   # 1024d
# # NIM_EMBED_MODEL=nvidia/nv-embed-v1        # 4096d
# # NIM_EMBED_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2 # 2048d
# NIM_INPUT_TYPE=                  # auto: save->passage, search->query (Nemotron/E5). Override if needed
# NIM_TRUNCATE=NONE
# NIM_DIM=2048                     # override dim (auto-inferred: 2048 for nemotron)

# Extractor (optional LLM)
# ENABLE_EXTRACTOR=false
# OPENAI_API_KEY=sk-...
# EXTRACTOR_MODEL=gpt-4o-mini

# Write-side judge (Jev) — optional. See README "Smart write gate".
# The key lives in a FILE, not here, so this file stays safe to share or paste.
# JEV_API_KEY_FILE=~/.pi/agent/typesafe-key.txt
# TYPESAFE_API_KEY=ts-...            # used only when no key file is set
# JEV_MODEL=jev-latest
# JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
# MEMORY_JEV_MIN=0.5                 # below this keep-probability, do not store
# MEMORY_JEV=false                   # disable entirely; heuristic gate only
