{
  "name": "open-memory",
  "version": "0.3.0-beta.1",
  "description": "Local-first memory for pi agents: SQLite + hybrid retrieval + hard token budget. One process, no UI framework.",
  "license": "MIT",
  "author": "stupidcoderathere <franklinwong207@gmail.com>",
  "repository": { "type": "git", "url": "git+https://github.com/codersdfs/open-memory.git" },
  "homepage": "https://github.com/codersdfs/open-memory#readme",
  "keywords": ["memory", "agents", "rag", "sqlite", "mcp", "vector-search", "local-first"],
  "engines": { "node": ">=22.5.0" },
  "type": "module",
  "bin": {
    "open-memory": "dist/src/cli/index.js",
    "ai-memory": "dist/src/cli/index.js"
  },
  "files": ["dist/src", "dist/scripts", "src/ui", "dist/src/ui-next", "README.md", "CHANGELOG.md", "CONTEXT.md", "LICENSE", "docs", ".env.example"],
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "ui:dev": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "ui:typecheck": "npm --prefix ui run typecheck",
    "start": "tsx src/api/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-ui.mjs",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "wiki:ingest": "tsx scripts/wiki-ingest.ts",
    "wiki:links": "tsx scripts/wiki-links.ts",
    "lint": "tsc -p tsconfig.lint.json",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.1"
  }
}
