node_modules/
dist/
*.db
*.db-wal
*.db-shm
test-*.db*
.env
# A copy of .env under any other name (`.env.bak`, `.env.local`, `.env.old`) is still a
# copy of every key in it: `.env` alone matched nothing else, and a `git add -A` would
# have committed a live NIM and JEV key. `.env.example` stays tracked on purpose.
.env*
!.env.example

# local tooling state, not project source
_asar/
.codegraph/
.codebase-memory/
.pi/
# .gitignore has no end-of-line comments — the first version of these lines ended with
# "# ..." and therefore matched nothing. Comments go on their own line.
# `bench/` is the LoCoMo harness's data and results directory. It is a bare directory
# pattern, so it matched `src/bench/` too and silently kept the real-time benchmark's
# source out of the 0.4.0-beta.1 commit — the test shipped, the module it imports did
# not, and the failure only showed on a clean checkout. Anchored to the root on purpose.
/bench/
downloads/
vault/
rea-usage.md
_vfy.sh
_wslsetup.sh

# Personal working notes for this machine only — network identifiers, tailnet names,
# local tooling decisions. Present but not versioned.
.promotions.json
agent-integration-plan.md
context-diet-plan.md
remote-pc-herdr.md
# A memory export of the real store: 380 KB of actual user memories. Debug input,
# never an artifact — one `git add -A` away from being public, and git history is
# forever. The same class of accident as the personal notes above, one level worse.
memlist-sample.json
# `undefined/<name>.db` is what a path-resolution failure writes when a DB path
# computes to undefined; the .db inside is already ignored, the dir must not
# outlive the probe that made it.
undefined/
.zcode/

# the console's toolchain: dev-only, never published (ADR-0007/0008)
ui/node_modules/
ui/dist/
.empryo
.superpowers/
